# Server Configuration
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:3000

# Security & JWT
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder_here
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Configuration (PostgreSQL for Production, auto-fallback to local DB in dev if unset)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zynora_db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# RAG Configuration
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CHUNKS=4
KNOWLEDGE_BASE_DIR=./knowledge-base
